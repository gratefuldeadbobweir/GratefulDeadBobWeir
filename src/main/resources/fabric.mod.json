{
  "schemaVersion": 1,
  "name": "Christmas",
  "id": "christmas-client",
  "version": "${version}",
  "description": "Based utility mod.",
  "authors": [
    "MineGame159",
    "squidoodly",
    "seasnail"
  ],
  "contact": {
    "sources": "https://github.com/gratefuldeadbobweir/GratefulDeadBobWeir",
    "issues": "https://github.com/gratefuldeadbobweir/GratefulDeadBobWeir/issues"
  },
  "license": "GPL-3.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "christmas.client.ChristmasClient"
    ],
    "modmenu": [
      "christmas.client.modintegration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "christmas-client.mixins.json",
    "christmas-client-baritone.mixins.json",
    "christmas-client-indigo.mixins.json",
    "christmas-client-iris.mixins.json",
    "christmas-client-sodium.mixins.json",
    "christmas-client-lithium.mixins.json",
    "christmas-client-metallum.mixins.json"
  ],
  "accessWidener": "christmas-client.classtweaker",
  "custom": {
    "christmas-client:build_number": "${build_number}",
    "christmas-client:color": "196,43,60",
    "christmas-client:commit": "${commit}",
    "badoptimizations:cache_hooks": {
      "lightmap": "christmas.client.modintegration.BadOptimizationsHook"
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "sodium": "<0.9.1",
    "morechathistory": "*",
    "lithium": "<0.22.1"
  }
}
